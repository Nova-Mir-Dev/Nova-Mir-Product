# Site URL (used in middleware, billing redirects, admin redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=  # Server-only — never expose to client
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres


# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Slack
SLACK_BOT_TOKEN=xoxb-
SLACK_SIGNING_SECRET=

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=https://novamir.dev,http://localhost:3000

# Upstash Redis (rate limiting) — must match @upstash/redis library convention
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# IP Allowlist (optional — comma-separated for admin-only access)
ALLOWED_IPS=

# Slack
SLACK_LEADS_CHANNEL=#leads

# Content revalidation (shared secret for ISR cache-busting)
REVALIDATION_SECRET=

# Pricing (configurable without code changes)
NEXT_PUBLIC_TIER1_NAME=Managed Website
NEXT_PUBLIC_TIER1_PRICE=1800
NEXT_PUBLIC_TIER2_NAME=Website + Lead System
NEXT_PUBLIC_TIER2_PRICE=3000
NEXT_PUBLIC_TIER3_NAME=Website + Operations
NEXT_PUBLIC_TIER3_PRICE=5000
NEXT_PUBLIC_FOUNDING_OFFER_COUNT=3
NEXT_PUBLIC_FOUNDING_OFFER_PRICE=2000
NEXT_PUBLIC_MAINTENANCE_MIN=300
NEXT_PUBLIC_MAINTENANCE_MAX=500