    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npx prettier --check ."
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@sentry/nextjs": "^10.56.0",
    "@slack/bolt": "^4.7.3",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.108.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "azimuth-ui": "^0.8.0",
    "next": "^16.2.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.8.1",
    "resend": "^6.14.0",
    "server-only": "^0.0.1",
    "stripe": "^17.0.0",
    "twilio": "^5.0.0",
    "zod": "^4.4.3"
