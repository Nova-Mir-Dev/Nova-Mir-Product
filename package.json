    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-istanbul": "^4.1.8",
    "axe-core": "^4.12.1",
    "eslint": "^10.4.1",
    "eslint-config-next": "^16.2.7",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8",
    "vitest-axe": "^0.1.0"
  },
  "overrides": {
    "postcss": "^8.5.10"
